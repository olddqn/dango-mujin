flowchart TD

  %% ─── INPUT ────────────────────────────────────────────────────
  CLAIM["📋 CLAIM\n─────────────\nstatement\nobserved_state\nmissing_conditions\ndignity_constraints"]

  %% ─── DIGNITY GATE ──────────────────────────────────────────────
  DIGNITY["🛡 DIGNITY GUARD\n─────────────\n7 rules\nconsent · anonymity\nrevocability · dignity"]
  BLOCK["🚫 BLOCK\nor ESCALATE"]

  %% ─── REASONING SURFACE (OGI) ───────────────────────────────────
  WORLDMODEL["🌍 WORLD MODEL\n─────────────\nobserved_state\ndesired_state\nstate_gap\nuncertainty\ndignity_surface"]
  PLANTREE["🌲 PLAN TREE\n─────────────\ngoal · subgoal\nbranch · task\nabstain\n[contestable]"]
  TASKBUNDLE["📦 TASK BUNDLE\n─────────────\ntask specs\ndependencies\nagent classes\n[derived, not executed]"]

  %% ─── NEGOTIATION ───────────────────────────────────────────────
  NEGOTIATE["⚖ NEGOTIATION\n─────────────\nsupport\nobjection\ncontest\ncorrect\nreject"]
  ACTIVEPLAN["✅ ACTIVE PLAN\n─────────────\n6 deterministic rules\ntransparent selection\nno hidden scoring"]

  %% ─── MEMORY ────────────────────────────────────────────────────
  MEMORY["🧠 REFLECTIVE MEMORY\n─────────────\nlearned_conditions\nprior_objections\ncorrection_depth\ncontest_count\n[structural diff]"]
  PRIORKNOWLEDGE["💡 PRIOR KNOWLEDGE\n─────────────\nfeeds next\nworld model cycle"]

  %% ─── TRUST ─────────────────────────────────────────────────────
  TRUST["📊 TRUST DECAY\n─────────────\nexponential decay\nhalf-life: 90 days\ndignity violation → 0\n[no floor]"]

  %% ─── IDENTITY ──────────────────────────────────────────────────
  DID["🔑 DID SIGNATURES\n─────────────\ndid:key identifiers\nspeaker/proposer\n[mock — test vectors]"]

  %% ─── FEDERATION ────────────────────────────────────────────────
  FEDERATION["🕸 CLAIM FEDERATION\n─────────────\ndepends_on\nenables\ncounterclaim\nderived_from\ndignity_override"]

  %% ─── PERSISTENCE ───────────────────────────────────────────────
  SUTABLE["📂 SU-TABLE (素テーブル)\n─────────────\nclaims.jsonl\nnegotiations.jsonl\nplans.jsonl\nmemory.jsonl\nfederation.jsonl\n[append-only · SHA256 chain]"]

  %% ─── ECONOMIC LAYER (HYPOTHETICAL) ────────────────────────────
  GITSEA["💸 GITSEA\n─────────────\nrepo asset\ncontribution stream\ncredit history\n[hypothetical]"]
  REPOASSET["🗂 REPO ASSET\n─────────────\nclaim_to_asset.py\nstream_preview.py\ncontribution_ledger.py"]

  %% ─── GRAPH EXPORT ──────────────────────────────────────────────
  GRAPH["📈 NEGOTIATION GRAPH\n─────────────\nMermaid · text · HTML\nall events\nclaim lifecycle"]

  %% ─── FLOWS ─────────────────────────────────────────────────────

  CLAIM --> DIGNITY
  DIGNITY -->|BLOCK| BLOCK
  DIGNITY -->|PASS| WORLDMODEL
  DIGNITY -->|PASS| REPOASSET

  WORLDMODEL --> PLANTREE
  PLANTREE --> TASKBUNDLE
  PLANTREE --> NEGOTIATE
  MEMORY -->|prior_knowledge\nlearned_conditions| WORLDMODEL

  NEGOTIATE -->|support · objection\ncontest · correct| PLANTREE
  NEGOTIATE --> ACTIVEPLAN
  ACTIVEPLAN -->|active plan selected| TASKBUNDLE
  ACTIVEPLAN --> MEMORY
  NEGOTIATE --> MEMORY

  MEMORY --> PRIORKNOWLEDGE
  PRIORKNOWLEDGE -.->|next cycle| WORLDMODEL

  TRUST -->|weight signals| NEGOTIATE
  DID -->|speaker identity| CLAIM
  DID -->|proposer identity| PLANTREE

  FEDERATION -->|context| WORLDMODEL
  FEDERATION -->|context| NEGOTIATE
  CLAIM --> FEDERATION

  SUTABLE -->|read| WORLDMODEL
  SUTABLE -->|read| NEGOTIATE
  SUTABLE -->|read| TRUST
  SUTABLE -->|read| FEDERATION
  SUTABLE -->|read| MEMORY
  CLAIM -->|write| SUTABLE
  PLANTREE -->|write| SUTABLE
  NEGOTIATE -->|write| SUTABLE
  TASKBUNDLE -->|write| SUTABLE
  MEMORY -->|write| SUTABLE
  FEDERATION -->|write| SUTABLE

  REPOASSET -.->|bridge\n[hypothetical]| GITSEA
  SUTABLE --> GRAPH

